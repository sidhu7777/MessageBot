graph LR
    START[Start]
    INIT["INIT<br/>(bold)"]
    BOOKING_FOR["ASK_BOOKING_FOR"]
    NAME["ASK_NAME"]
    PHONE["ASK_PHONE"]
    CLINIC["ASK_CLINIC"]
    DATE["ASK_DATE"]
    TIME["ASK_TIME"]
    CONFIRM["CONFIRM"]
    COMPLETED["COMPLETED<br/>(success)"]
    
    AVAIL_DATE["ASK_AVAILABILITY_DATE"]
    AVAIL_DETAILS["ASK_AVAILABILITY_DETAILS"]
    
    EXISTING_ACTION["ASK_EXISTING_BOOKING_ACTION"]
    EXISTING_PICK["ASK_EXISTING_BOOKING_PICK"]
    CONFIRM_RESCHEDULE["CONFIRM_RESCHEDULE"]
    
    MAX_ACTIVE["ASK_MAX_ACTIVE_BOOKINGS_ACTION"]
    CHANGE["ASK_CHANGE_FIELD"]
    CANCELLED["CANCELLED<br/>(end)"]
    
    START --> INIT
    INIT --> BOOKING_FOR
    INIT --> AVAIL_DATE
    
    AVAIL_DATE --> AVAIL_DETAILS
    AVAIL_DETAILS --> BOOKING_FOR
    
    BOOKING_FOR --> NAME
    NAME --> PHONE
    PHONE --> CLINIC
    CLINIC --> DATE
    DATE --> TIME
    TIME --> CONFIRM
    CONFIRM --> COMPLETED
    
    INIT --> EXISTING_ACTION
    EXISTING_ACTION --> EXISTING_PICK
    EXISTING_PICK --> CONFIRM_RESCHEDULE
    CONFIRM_RESCHEDULE --> COMPLETED
    EXISTING_PICK --> COMPLETED
    
    BOOKING_FOR --> MAX_ACTIVE
    MAX_ACTIVE --> CHANGE
    MAX_ACTIVE --> CANCELLED
    CHANGE --> COMPLETED
    
    COMPLETED --> INIT
    
    style START fill:#ecebfd,stroke:#7e78cc
    style INIT fill:#ecebfd,stroke:#7e78cc
    style COMPLETED fill:#eaf8ee,stroke:#4a9b68
    style CANCELLED fill:#eaf8ee,stroke:#4a9b68
